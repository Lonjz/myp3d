USE_SYSTEM_FFMPEG=false

# optional: browser yt-dlp borrows YouTube cookies from when YouTube asks to sign in (firefox, chrome, edge, ...)
YTDLP_COOKIES_BROWSER=

# optional: name or full path of a specific browser profile
YTDLP_COOKIES_PROFILE=

# optional: YouTube player clients to extract from, tried in order (default: default,tv,ios)
# YTDLP_PLAYER_CLIENTS=default,tv,ios

# optional: where the MP3 library lives (defaults to ./downloads)
MYP3D_LIBRARY_DIR=

# optional: where the database lives (defaults to ./myp3d.db)
MYP3D_DB_PATH=

# optional: backend port
API_PORT=8000

# optional: restart the backend when its code changes (for development)
API_RELOAD=false
